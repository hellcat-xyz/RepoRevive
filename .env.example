# PostgreSQL connection (docker compose up -d db). Copy this file to .env; values below are local-development placeholders.
DATABASE_URL="postgresql://reporevive:reporevive@localhost:5432/reporevive?schema=public"

# Where the worker keeps per-job workspaces (cloned repos, npm caches). Must be on a path Docker can bind-mount.
REPOREVIVE_DATA_DIR="./.data"

# Worker
WORKER_CONCURRENCY=2
# Total wall-clock budget per resurrection, in minutes
JOB_TIMEOUT_MINUTES=45
MAX_REPAIR_ATTEMPTS=12
# Most projects verified per repository (MERN client/server, monorepo folders). Each gets its own repair budget.
MAX_SUBPROJECTS=4

# Sandbox limits
SANDBOX_MEMORY="2g"
SANDBOX_CPUS="2"
SANDBOX_PIDS_LIMIT=512
INSTALL_TIMEOUT_SECONDS=600
BUILD_TIMEOUT_SECONDS=600
TEST_TIMEOUT_SECONDS=600
# Allow network during build/test (default false: only clone and install get network)
SANDBOX_NETWORK_FOR_BUILD=false

# Max repository size accepted (MB, from GitHub API metadata)
MAX_REPO_SIZE_MB=300

# Optional: raises GitHub API rate limits for repository metadata lookups. Never given to sandboxes.
GITHUB_TOKEN=

# Optional: enables the AI fix strategy (OpenAI-compatible chat completions API)
LLM_API_KEY=
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o-mini"
# Most AI proposals per issue. Each is verified in the sandbox and rolled back if it does not help.
LLM_MAX_ATTEMPTS_PER_ISSUE=3

# API rate limit: new resurrections per client IP per minute
RATE_LIMIT_PER_MINUTE=5

# ---------------------------------------------------------------------------
# Optional: GitHub pull requests (see README "Optional: GitHub pull requests").
# Leave all of these empty to keep patch-only mode. Setting only some is a startup error.
# Never commit real values.
# ---------------------------------------------------------------------------
# From your GitHub App settings
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The app slug (github.com/apps/<slug>), used for the install link
GITHUB_APP_SLUG=
# Public origin of this app; the OAuth callback is <APP_BASE_URL>/api/github/callback
# APP_BASE_URL="http://localhost:3000"
# 32+ random characters: openssl rand -hex 32
SESSION_SECRET=
# base64 of 32 random bytes: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=